rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    match /publicContent/{contentId} {
      allow get: if contentId == 'notesAndPricing';
      allow list: if false;

      allow create, update: if contentId == 'notesAndPricing'
        && isAdmin()
        && request.resource.data.keys().hasAll([
          'notes', 'pricing', 'updatedAt', 'updatedBy'
        ])
        && request.resource.data.keys().hasOnly([
          'notes', 'pricing', 'updatedAt', 'updatedBy'
        ])
        && request.resource.data.notes is string
        && request.resource.data.notes.size() <= 2000
        && request.resource.data.pricing is string
        && request.resource.data.pricing.size() <= 2000
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid;

      allow delete: if false;
    }

    // Admin-only running notes; never exposed to customers.
    match /workNotes/{notesId} {
      allow get, list: if isAdmin();

      allow create, update: if isAdmin()
        && notesId == 'main'
        && request.resource.data.keys().hasAll([
          'notes', 'updatedAt', 'updatedBy'
        ])
        && request.resource.data.keys().hasOnly([
          'notes', 'updatedAt', 'updatedBy'
        ])
        && request.resource.data.notes is string
        && request.resource.data.notes.size() <= 32000
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid;

      allow delete: if false;
    }

    // Per-user layout preferences (handedness and light/dark theme). Customers
    // and admins read and write only their own document, and only the two
    // fields the app actually stores.
    match /userSettings/{userId} {
      allow get: if signedIn() && userId == request.auth.uid;
      allow list: if false;

      allow create, update: if signedIn()
        && userId == request.auth.uid
        && request.resource.data.keys().hasAll(['leftHanded', 'themeMode'])
        && request.resource.data.keys().hasOnly(['leftHanded', 'themeMode'])
        && request.resource.data.leftHanded is bool
        && request.resource.data.themeMode in ['system', 'light', 'dark'];

      allow delete: if false;
    }

    match /appointments/{appointmentId} {
      function ownsAppointment() {
        return signedIn() && resource.data.userId == request.auth.uid;
      }

      allow create: if signedIn()
        && request.resource.data.keys().hasAll([
          'appointmentDate', 'timeSlot', 'customerName', 'phone',
          'streetAddress', 'city', 'postalCode', 'issueDescription',
          'userId', 'createdAt', 'status', 'serviceType'
        ])
        && request.resource.data.keys().hasOnly([
          'appointmentDate', 'timeSlot', 'customerName', 'phone',
          'streetAddress', 'city', 'postalCode', 'issueDescription',
          'userId', 'userEmail', 'createdAt', 'status', 'photoPath',
          'serviceType'
        ])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.appointmentDate is timestamp
        && request.resource.data.timeSlot is string
        && request.resource.data.customerName is string
        && request.resource.data.phone is string
        && request.resource.data.streetAddress is string
        && request.resource.data.city is string
        && request.resource.data.postalCode is string
        && request.resource.data.issueDescription is string
        && request.resource.data.serviceType is string
        && request.resource.data.serviceType.size() <= 40
        && request.resource.data.createdAt == request.time
        && request.resource.data.status == 'scheduled'
        && (!('userEmail' in request.resource.data)
          || request.resource.data.userEmail is string)
        && (!('photoPath' in request.resource.data)
          || request.resource.data.photoPath is string);

      // Admin-only placeholder entry that blocks a time slot from booking.
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly([
          'appointmentDate', 'timeSlot', 'status', 'createdBy', 'createdAt'
        ])
        && request.resource.data.keys().hasAll([
          'appointmentDate', 'timeSlot', 'status', 'createdBy', 'createdAt'
        ])
        && request.resource.data.status == 'blockedoff'
        && request.resource.data.appointmentDate is timestamp
        && request.resource.data.timeSlot is string
        && request.resource.data.timeSlot.size() <= 40
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time;

      allow get, list: if ownsAppointment() || isAdmin();

      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status'])
        && request.resource.data.status in ['scheduled', 'cancelled', 'completed'];

      // Customers may cancel their own scheduled appointment.
      allow update: if ownsAppointment()
        && resource.data.status == 'scheduled'
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status'])
        && request.resource.data.status == 'cancelled';

      // Customers may edit the name, issue description, and add a photo on
      // their own scheduled appointment. The photo is add-only so an existing
      // attachment cannot be replaced or removed.
      allow update: if ownsAppointment()
        && resource.data.status == 'scheduled'
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['customerName', 'issueDescription', 'photoPath'])
        && request.resource.data.customerName is string
        && request.resource.data.customerName.size() <= 80
        && request.resource.data.issueDescription is string
        && request.resource.data.issueDescription.size() <= 2000
        && (!request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['photoPath'])
          || (request.resource.data.photoPath is string
            && resource.data.get('photoPath', '') == ''));

      // Admins may attach a free-text note to any booking; an empty string
      // clears it, so the field stays a string for every write.
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['adminNote'])
        && request.resource.data.adminNote is string
        && request.resource.data.adminNote.size() <= 2000;

      allow delete: if isAdmin();
    }

    // Public-safe availability index: no personal data, one doc per date+slot.
    match /bookedSlots/{slotId} {
      function linkedAppointment() {
        return getAfter(/databases/$(database)/documents/appointments/$(request.resource.data.appointmentId)).data;
      }

      allow get, list: if signedIn();

      // Must be written in the same batch as the appointment it refers to.
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'appointmentDate', 'timeSlot', 'appointmentId'
        ])
        && request.resource.data.keys().hasAll([
          'appointmentDate', 'timeSlot', 'appointmentId'
        ])
        && request.resource.data.appointmentDate is timestamp
        && request.resource.data.timeSlot is string
        && request.resource.data.timeSlot.size() <= 40
        && request.resource.data.appointmentId is string
        && linkedAppointment().appointmentDate == request.resource.data.appointmentDate
        && linkedAppointment().timeSlot == request.resource.data.timeSlot
        && (linkedAppointment().get('userId', '') == request.auth.uid
          || linkedAppointment().get('createdBy', '') == request.auth.uid);

      allow update: if false;

      // Admins release slots when unblocking; customers release only the slot
      // of their own appointment (a missing slot doc is a harmless no-op).
      allow delete: if isAdmin();
      allow delete: if signedIn()
        && (resource == null
          || (resource.data.appointmentId is string
            && get(/databases/$(database)/documents/appointments/$(resource.data.appointmentId)).data.userId == request.auth.uid));
    }
  }
}
